// Cloudflare Workers (solo archivos estáticos): sirve el build de Vite.
// "single-page-application" devuelve index.html en cualquier ruta (/r/<codigo>, /ronda/...).
// Los headers del service worker y del manifiesto están en public/_headers.
{
  "name": "cabina-86",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Vistas previas de las ramas que no son la de producción (wrangler preview)
  "previews": {}
}
